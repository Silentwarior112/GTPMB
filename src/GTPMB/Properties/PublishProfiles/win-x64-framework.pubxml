<?xml version="1.0" encoding="utf-8"?>
<!-- One small framework-dependent GTGPBc.exe: needs the .NET 10 Desktop Runtime on the target machine.
     dotnet publish src\GTGPBc\GTGPBc.csproj -p:PublishProfile=win-x64-framework -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Keep the publish folder to the one exe: GTGPBc.Core's separate .pdb is not copied next to it. -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-x64-framework\</PublishDir>
  </PropertyGroup>
</Project>
